# ================================================================
#  Конфигурация Docker-развертывания
#  Учебный отдел ВШПМ СПбГУПТД
#
#  Скопируйте этот файл в .env и отредактируйте при необходимости:
#    cp .env.example .env
#
#  Или запустите setup.sh — он создаст .env интерактивно.
# ================================================================

# --- MySQL root пароль ---
# Пароль суперпользователя MySQL внутри контейнера.
# Используется только для администрирования БД изнутри.
MYSQL_ROOT_PASSWORD=root_secret

# --- База данных приложения ---
# Имя создаваемой базы данных
DB_NAME=vshpm_edu

# Пользователь БД (создается автоматически при первом запуске)
DB_USER=vshpm

# Пароль пользователя БД
DB_PASS=vshpm_secret

# --- Порты ---
# Внешний порт для MySQL (на хосте).
# По умолчанию 3307, чтобы не конфликтовать с локальным MySQL на 3306.
DB_PORT=3307

# Внешний порт для веб-приложения (на хосте).
# Приложение будет доступно по http://localhost:8080
APP_PORT=8080