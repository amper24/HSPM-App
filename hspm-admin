#!/usr/bin/env php
<?php
/**
 * hspm-admin — CLI-утилита управления приложением «Учебный отдел ВШПМ»
 *
 * Использование:
 *   docker exec vshpm-app php /var/www/html/hspm-admin [команда] [опции]
 *
 * Команды:
 *   info              — общая информация о системе
 *   stats             — статистика БД
 *   reset-password    — сброс пароля пользователя
 *   create-user       — создать пользователя
 *   list-users        — список пользователей
 *   truncate TABLE    — очистить таблицу (teachers, classrooms, schedule, software)
 *   import TYPE FILE  — импорт файла (teachers|classrooms|schedule|software)
 *   db-check          — проверка подключения к БД и структуры
 *   help              — справка
 */

define('APP_NAME', 'Учебный отдел ВШПМ СПбГУПТД');
define('APP_VERSION', '1.0.0');

// Подключаем конфиг без CORS/сессий (CLI-режим)
$_SERVER['REQUEST_METHOD'] = 'CLI';
require_once __DIR__ . '/api/config.php';

$command = $argv[1] ?? 'help';

echo "\n\033[1;36m  " . APP_NAME . " v" . APP_VERSION . "\033[0m\n";
echo "  CLI-утилита администрирования\n\n";

switch ($command) {
    case 'info':       cmd_info(); break;
    case 'stats':      cmd_stats(); break;
    case 'reset-password': cmd_reset_password($argv); break;
    case 'create-user':   cmd_create_user($argv); break;
    case 'list-users':    cmd_list_users(); break;
    case 'truncate':      cmd_truncate($argv); break;
    case 'import':        cmd_import($argv); break;
    case 'db-check':      cmd_db_check(); break;
    case 'backup':        cmd_backup(); break;
    case 'restore':       cmd_restore($argv); break;
    case 'help': default: cmd_help(); break;
}

echo "\n";

// ====================== КОМАНДЫ ======================

function cmd_info(): void {
    $pdo = getDB();
    echo "\033[1;33m── Система ──\033[0m\n";
    echo "  PHP:        " . PHP_VERSION . "\n";
    echo "  MySQL:      " . $pdo->query("SELECT VERSION()")->fetchColumn() . "\n";
    echo "  База:       " . DB_NAME . "@" . DB_HOST . ":" . (getenv('DB_PORT') ?: '3306') . "\n";
    echo "  Кодировка:  " . DB_CHARSET . "\n";
    echo "  Локаль:     " . (getenv('LANG') ?: 'не задана') . "\n";
    echo "  Часовой пояс: " . date_default_timezone_get() . "\n";
    echo "  Документ-рут: " . realpath(__DIR__) . "\n";
    
    echo "\n\033[1;33m── Доступ ──\033[0m\n";
    echo "  URL:        http://localhost:" . (getenv('APP_PORT') ?: '8080') . "\n";
    echo "  Логин:      admin\n";
    echo "  Пароль:     admin123\n";
    
    cmd_stats();
}

function cmd_stats(): void {
    $pdo = getDB();
    $counts = [
        'users'       => 'Пользователей',
        'teachers'    => 'Преподавателей',
        'classrooms'  => 'Аудиторий',
        'schedule'    => 'Записей расписания',
        'software'    => 'Записей ПО',
    ];
    
    echo "\n\033[1;33m── Статистика БД ──\033[0m\n";
    foreach ($counts as $table => $label) {
        try {
            $cnt = $pdo->query("SELECT COUNT(*) FROM `$table`")->fetchColumn();
            echo sprintf("  %-22s %s\n", $label . ':', $cnt);
        } catch (Exception $e) {
            echo sprintf("  %-22s %s\n", $label . ':', "\033[31mОШИБКА\033[0m");
        }
    }
    
    echo "\n\033[1;33m── Связи расписания ──\033[0m\n";
    $linked = $pdo->query("SELECT COUNT(*) FROM schedule WHERE teacher_id IS NOT NULL")->fetchColumn();
    $total = $pdo->query("SELECT COUNT(*) FROM schedule")->fetchColumn();
    echo "  С преподавателем:  $linked / $total\n";
    
    $linked = $pdo->query("SELECT COUNT(*) FROM schedule WHERE classroom_id IS NOT NULL")->fetchColumn();
    echo "  С аудиторией:      $linked / $total\n";
    
    echo "\n\033[1;33m── Дисковое пространство (БД) ──\033[0m\n";
    $size = $pdo->query("
        SELECT ROUND(SUM(data_length + index_length) / 1024 / 1024, 2) 
        FROM information_schema.tables 
        WHERE table_schema = '" . DB_NAME . "'
    ")->fetchColumn();
    echo "  Размер БД:    {$size} MB\n";
}

function cmd_reset_password(array $argv): void {
    $username = $argv[2] ?? 'admin';
    $password = $argv[3] ?? null;
    
    if ($password === null) {
        echo "\033[33mИспользование: hspm-admin reset-password [username] [new-password]\033[0m\n";
        echo "  По умолчанию: username=admin, пароль генерируется\n\n";
        $password = bin2hex(random_bytes(6));
        echo "  Сгенерирован пароль: \033[1;32m{$password}\033[0m\n";
    }
    
    $pdo = getDB();
    $hash = password_hash($password, PASSWORD_BCRYPT);
    $stmt = $pdo->prepare("UPDATE users SET password = :hash WHERE username = :user");
    $stmt->execute(['hash' => $hash, 'user' => $username]);
    
    if ($stmt->rowCount() === 0) {
        echo "\n  \033[31mПользователь '$username' не найден!\033[0m\n";
        return;
    }
    
    echo "\n  \033[1;32mПароль для '$username' сброшен.\033[0m\n";
    echo "  Логин:    {$username}\n";
    echo "  Пароль:   {$password}\n";
}

function cmd_create_user(array $argv): void {
    $username = $argv[2] ?? null;
    $password = $argv[3] ?? null;
    $role     = $argv[4] ?? 'user';
    $fullName = $argv[5] ?? $username;
    
    if ($username === null || $password === null) {
        echo "\033[33mИспользование: hspm-admin create-user <username> <password> [role] [full_name]\033[0m\n";
        echo "  role: admin или user (по умолчанию user)\n";
        return;
    }
    
    if (!in_array($role, ['admin', 'user'])) {
        echo "\033[31mРоль должна быть 'admin' или 'user'\033[0m\n";
        return;
    }
    
    $pdo = getDB();
    $hash = password_hash($password, PASSWORD_BCRYPT);
    
    try {
        $stmt = $pdo->prepare("INSERT INTO users (username, password, role, full_name) VALUES (:u, :p, :r, :f)");
        $stmt->execute(['u' => $username, 'p' => $hash, 'r' => $role, 'f' => $fullName]);
        echo "\n  \033[1;32mПользователь '$username' создан (роль: $role).\033[0m\n";
    } catch (Exception $e) {
        if (strpos($e->getMessage(), 'Duplicate') !== false) {
            echo "\n  \033[31mПользователь '$username' уже существует!\033[0m\n";
        } else {
            echo "\n  \033[31mОшибка: " . $e->getMessage() . "\033[0m\n";
        }
    }
}

function cmd_list_users(): void {
    $pdo = getDB();
    $users = $pdo->query("SELECT id, username, role, full_name, created_at FROM users ORDER BY id")->fetchAll();
    
    echo "\n\033[1;33m── Пользователи ──\033[0m\n\n";
    printf("  %-4s %-20s %-8s %-30s %s\n", 'ID', 'Логин', 'Роль', 'ФИО', 'Создан');
    echo "  " . str_repeat('─', 80) . "\n";
    foreach ($users as $u) {
        printf("  %-4s %-20s %-8s %-30s %s\n", $u['id'], $u['username'], $u['role'], mb_substr($u['full_name'] ?? '', 0, 28), $u['created_at']);
    }
}

function cmd_truncate(array $argv): void {
    $table = $argv[2] ?? null;
    
    $allowed = ['teachers', 'classrooms', 'schedule', 'software'];
    if (!in_array($table, $allowed)) {
        echo "\033[33mИспользование: hspm-admin truncate <table>\033[0m\n";
        echo "  Допустимые таблицы: " . implode(', ', $allowed) . "\n";
        return;
    }
    
    $pdo = getDB();
    $pdo->exec("SET FOREIGN_KEY_CHECKS=0");
    $pdo->exec("TRUNCATE TABLE `$table`");
    $pdo->exec("SET FOREIGN_KEY_CHECKS=1");
    
    echo "\n  \033[1;32mТаблица '$table' очищена.\033[0m\n";
}

function cmd_import(array $argv): void {
    $type = $argv[2] ?? null;
    $file = $argv[3] ?? null;
    
    $allowed = ['teachers', 'classrooms', 'schedule', 'software'];
    if (!in_array($type, $allowed) || $file === null || !file_exists($file)) {
        echo "\033[33mИспользование: hspm-admin import <type> <file>\033[0m\n";
        echo "  type: teachers | classrooms | schedule | software\n";
        echo "  file: путь к .xlsx/.xls файлу\n";
        return;
    }
    
    echo "\n  Импорт '$type' из " . basename($file) . " ...\n";
    
    require_once __DIR__ . '/vendor/autoload.php';
    require_once __DIR__ . '/api/import.php';
    
    $ext = strtolower(pathinfo($file, PATHINFO_EXTENSION));
    if (!in_array($ext, ['xlsx', 'xls'])) {
        echo "\033[31m  Поддерживаются только .xlsx и .xls\033[0m\n";
        return;
    }
    
    try {
        $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($file);
    } catch (Exception $e) {
        echo "\033[31m  Ошибка чтения файла: " . $e->getMessage() . "\033[0m\n";
        return;
    }
    
    $pdo = getDB();
    $imported = 0;
    
    switch ($type) {
        case 'teachers':    $imported = importTeachers($spreadsheet, $pdo); break;
        case 'classrooms':  $imported = importClassrooms($spreadsheet, $pdo); break;
        case 'schedule':    $imported = importSchedule($spreadsheet, $pdo); break;
        case 'software':    $imported = importSoftware($spreadsheet, $pdo); break;
    }
    
    echo "  \033[1;32mИмпортировано записей: $imported\033[0m\n";
}

function cmd_db_check(): void {
    $pdo = getDB();
    
    echo "\n\033[1;33m── Проверка БД ──\033[0m\n\n";
    
    $checks = [
        ['Подключение к БД', 'SELECT 1'],
    ];
    
    $tables = ['users', 'classrooms', 'teachers', 'schedule', 'software'];
    foreach ($tables as $t) {
        $checks[] = ["Таблица '$t'", "SELECT COUNT(*) FROM `$t`"];
    }
    
    // Проверка индексов
    $checks[] = ["Индекс teachers (ФИО)", "SHOW INDEX FROM teachers WHERE Key_name = 'idx_unique_fio'"];
    $checks[] = ["Индекс classrooms (№+здание)", "SHOW INDEX FROM classrooms WHERE Key_name = 'idx_room_building'"];
    
    foreach ($checks as [$label, $sql]) {
        try {
            $result = $pdo->query($sql);
            $ok = ($result->rowCount() > 0 || $result->fetchColumn() !== false) ? "\033[32m✓\033[0m" : "\033[33m?\033[0m";
            echo "  $ok  $label\n";
        } catch (Exception $e) {
            echo "  \033[31m✗  $label — ОШИБКА\033[0m\n";
        }
    }
    
    echo "\n  \033[32mПроверка завершена.\033[0m\n";
}

function cmd_backup(): void {
    $pdo = getDB();
    $backupDir = '/var/www/html/backups';
    if (!is_dir($backupDir)) mkdir($backupDir, 0777, true);
    
    $filename = $backupDir . '/dump_' . date('Y-m-d_H-i-s') . '.sql';
    
    $tables = ['users', 'classrooms', 'teachers', 'schedule', 'software'];
    
    $sql = "-- hspm-admin backup: " . date('Y-m-d H:i:s') . "\n";
    $sql .= "SET NAMES utf8;\n\n";
    
    foreach ($tables as $table) {
        $rows = $pdo->query("SELECT * FROM `$table`")->fetchAll(PDO::FETCH_ASSOC);
        if (empty($rows)) continue;
        
        $sql .= "-- Table: $table\n";
        $cols = array_keys($rows[0]);
        $sql .= "INSERT INTO `$table` (`" . implode('`, `', $cols) . "`) VALUES\n";
        
        $values = [];
        foreach ($rows as $row) {
            $vals = array_map(function($v) use ($pdo) {
                if ($v === null) return 'NULL';
                return $pdo->quote($v);
            }, $row);
            $values[] = '(' . implode(', ', $vals) . ')';
        }
        $sql .= implode(",\n", $values) . ";\n\n";
    }
    
    file_put_contents($filename, $sql);
    $size = round(filesize($filename) / 1024, 1);
    echo "\n  \033[1;32mБекап сохранен: $filename ({$size} KB)\033[0m\n";
}

function cmd_restore(array $argv): void {
    $file = $argv[2] ?? null;
    
    if ($file === null || !file_exists($file)) {
        // Показать доступные бекапы
        $backupDir = '/var/www/html/backups';
        echo "\033[33mИспользование: hspm-admin restore <файл>\033[0m\n\n";
        if (is_dir($backupDir)) {
            $files = glob($backupDir . '/dump_*.sql');
            if (empty($files)) {
                echo "  Нет доступных бекапов в $backupDir\n";
            } else {
                echo "  Доступные бекапы:\n";
                rsort($files);
                foreach (array_slice($files, 0, 10) as $f) {
                    echo "    " . basename($f) . "  (" . round(filesize($f)/1024, 1) . " KB)\n";
                }
            }
        }
        return;
    }
    
    $pdo = getDB();
    $sql = file_get_contents($file);
    
    // Отключаем FK и очищаем таблицы
    $pdo->exec("SET FOREIGN_KEY_CHECKS=0");
    $tables = ['schedule', 'software', 'teachers', 'classrooms', 'users'];
    foreach ($tables as $t) $pdo->exec("DELETE FROM `$t`");
    
    // Выполняем SQL
    $statements = array_filter(array_map('trim', explode(";\n", $sql)));
    $count = 0;
    foreach ($statements as $stmt) {
        if (strpos($stmt, 'INSERT INTO') === 0) {
            $pdo->exec($stmt);
            $count++;
        }
    }
    $pdo->exec("SET FOREIGN_KEY_CHECKS=1");
    
    echo "\n  \033[1;32mВосстановлено из бекапа: $count запросов\033[0m\n";
    cmd_stats();
}

function cmd_help(): void {
    echo "\033[1;33mКоманды:\033[0m\n\n";
    
    $commands = [
        'info'              => 'Общая информация о системе и доступ',
        'stats'             => 'Статистика БД (количество записей)',
        'db-check'          => 'Проверка подключения к БД и структуры',
        'reset-password'    => 'Сброс пароля [username] [new-password]',
        'create-user'       => 'Создать пользователя <username> <password> [role] [name]',
        'list-users'        => 'Список всех пользователей',
        'truncate TABLE'    => 'Очистить таблицу (teachers|classrooms|schedule|software)',
        'import TYPE FILE'  => 'Импорт файла (teachers|classrooms|schedule|software)',
        'help'              => 'Эта справка',
    ];
    
    $commands['backup'] = 'Создать бекап БД в /var/www/html/backups/';
    $commands['restore [file]'] = 'Восстановить БД из бекапа';
    
    foreach ($commands as $cmd => $desc) {
        printf("  \033[1;36m%-22s\033[0m %s\n", $cmd, $desc);
    }
    
    echo "\n\033[33mБыстрый старт (из контейнера):\033[0m\n";
    echo "  docker exec vshpm-app php /var/www/html/hspm-admin info\n";
    echo "  docker exec vshpm-app php /var/www/html/hspm-admin reset-password\n";
    echo "  docker exec vshpm-app php /var/www/html/hspm-admin stats\n";
    
    echo "\n\033[33mАлиас (в .bashrc контейнера):\033[0m\n";
    echo "  alias hspm='php /var/www/html/hspm-admin'\n";
    echo "  hspm info\n";
    echo "  hspm reset-password\n";
}